 for(var toggle,toggles=document.querySelectorAll(".c-hamburger"),i=toggles.length-1;i>=0;i--)toggleHandler(toggles[i]);function toggleHandler(e){e.addEventListener("click",function(e){e.preventDefault(),!0===this.classList.contains("is-active")?(this.classList.remove("is-active"),$(".open").removeClass("oppenned")):(this.classList.add("is-active"),$(".open").addClass("oppenned"))})}$(".sub-menu li a").click(function(e){$(".open").removeClass("oppenned"),$(".c-hamburger").removeClass("is-active")});

