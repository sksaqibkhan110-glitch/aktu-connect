<script>

	$(document).ready(function () {

		var storage = window.sessionStorage;

		var currUrl = window.location.href;



		/*if(currUrl.includes("utm_")){

			storage.setItem('cta_number','+91-9555223721');

		}



		if (storage.getItem("cta_number") !== null) {

			$('a.cta_number').text("IN "+storage.getItem('cta_number'));

			$('a.cta_number').attr('href',storage.getItem('cta_number'));

		}*/



		//console.log("http://ipinfo.io/2401:4900:8842:2b8f:8c5:ccc5:a4bc:72a7/json");

		var site_url = 'https://www.stercodigitex.com/';



		var prev_prev_url = JSON.parse(storage.getItem("prev_prev_url"));

		if (prev_prev_url == null) prev_prev_url = [];

		prev_prev_url.push(currUrl);

		storage.setItem("prev_prev_url", JSON.stringify(prev_prev_url));



		$.ajax({

			method: 'post',

			url: site_url + 'updateanalytics',

			data: { site_url: site_url, current_url: $('#current_url').val(), prev_url: $('#prev_url').val(), prev_prev_url: storage.getItem("prev_prev_url"), browser: $('#browser').val(), ipaddress: $('#ipaddress').val(), iplocation: $('#iplocation').val(), location_city: $('#location_city').val() },

			success: function (res) { }

		});





		var url = window.location.href;

		$('.custom-navbar a').each(function () {

			if (url == $(this).attr('href')) {

				$(this).parent('li').addClass('active');

			}

		});



		$('[data-toggle="tooltip"]').tooltip();

		$('img').each(function () {

			var $img = $(this);

			//var imgPath = $img.attr('data-src'); //For Data-src

			if ($img.attr('alt') == '') {

				var imgPath = $img.prop('src'); //For only src

				var breakPath = imgPath.split('/');

				var getImageExtension = breakPath[breakPath.length - 1];

				var imgName = getImageExtension.split('.')[0];

				$(this).attr('alt', imgName);

			}

		});

	});



	$(function () {

		$(".solutions_box").slice(0, 0).show();

		$("#load_more").click(function (e) {

			e.preventDefault();

			$(".solutions_box:hidden").slice(0, 3).show("slow");

			if ($(".solutions_box:hidden").length == 0) {

				alert("No More Company")

			}

		});

	});





	$(document).ready(function () {

		var inputValue = $('body').attr('class');

		if (inputValue == 'work_page contact_hide') { $('.headergetquote').text('CONTACT US'); } else { $('.headergetquote').text('GET A QUOTE'); }

        

         $(document).on("click", ".whatsapp-link", function(b) {

        var c = window.location.href;

        if (c) {

            $.ajax({

                url: "https://www.stercodigitex.com/enquire/whatsapp_enquire",

                method: "POST",

