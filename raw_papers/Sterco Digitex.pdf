                    var url_open = "https://api.whatsapp.com/send/?phone=919310720206&text=Hi";

					window.open(url_open, '_blank');

                }

            });

          }

        });

	});



</script>





<script>

	$(document).ready(function(){

    $(".dropdown_wrap h5").click(function(){

        var $this = $(this);

        var $dropdownMenu = $this.next(".service_dropmenu");

        // Check if the dropdown is already open

        if ($dropdownMenu.is(":visible")) {

            // Close the dropdown and remove the 'active' class

            $dropdownMenu.slideUp();

            $this.removeClass('active');

        } else {

            // Close all other dropdowns and remove 'active' class from all h5 elements

            $(".service_dropmenu").slideUp();

            $(".dropdown_wrap h5").removeClass('active');

            // Open the clicked dropdown and add 'active' class

            $dropdownMenu.stop(true, true).slideToggle();

            $this.addClass('active');

        }

    });

        $(".btn-getaquote").click(function() {

            $(".adm-popup").addClass("menuopened1");

        });

    });

</script>

</body>



