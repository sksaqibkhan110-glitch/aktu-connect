<style>
.Infrastructure-tab .accordion-button:not(.collapsed)::after{
        background-position: 10px 6px !important;
    
}
#wpadminbar { display:block !important; }

@keyframes animate {
            0% {
                opacity:0.2;
                background:green;
                font-weight:bold;
               
            }
  
            50% {
                opacity: 0.7;
                background:red;
                font-weight:bold;
                
            }
  
            100% {
                opacity: 0.4;
                background:yellow;
                font-weight:bold;
                 
            }
        }
        
#newlink{
        animation: animate 
                0.8s linear infinite;
            
        }
        
      @media (max-width: 991px){
.dpt_btn {
        right: -286px !important;
        top:299px !important;
}
            
        }
        .hacknovate-main-btn {
    position: fixed;
    bottom: 10rem;
    left: 2rem;
    z-index: 9;
    transition: .3s;
    
}
